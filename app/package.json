{
  "name": "ecohanoi",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "smoke": "node scripts/smoke-test.mjs",
    "predeploy": "node scripts/smoke-test.mjs --require-api",
    "test:checks": "node --test scripts/smoke-test.test.mjs",
    "eas-build-pre-install": "node scripts/check-build-env.mjs",
    "sync-rules": "node scripts/sync-rules.mjs",
    "prestart": "node scripts/sync-rules.mjs",
    "preandroid": "node scripts/sync-rules.mjs",
    "eas-build-post-install": "node scripts/sync-rules.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
